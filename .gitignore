# macOS
.DS_Store

# Xcode / build artifacts
build/
artifacts/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/

# The .xcodeproj is generated from project.yml (the source of truth) but is
# committed for convenience so the project can be opened without XcodeGen.
# Only user-specific state inside it is ignored (see xcuserdata rules above).

# Signing material — private keys and certs never enter the repo
signing/
*.p8

# SDD scratch
.superpowers/

# RAW test fixtures — not committed (real camera files); README explains why
Tests/Fixtures/RAW/*
!Tests/Fixtures/RAW/README.md

# Parity fixtures — personal-photo TIFF exports from Lightroom, not
# committed. Only the TIFFs are ignored, so the manifest (generated, not a
# photo) and the README stay tracked without needing negations.
Tests/Fixtures/Parity/*.tif

# Generated XMP presets — reproducible from scripts/make-parity-presets.swift
scripts/parity-presets/

# Worktrees (isolated workspaces)
.worktrees/
# SDD plan workspaces
.superpowers/

# Harness-managed worktrees
.claude/worktrees/
